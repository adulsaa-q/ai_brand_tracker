# ============================================================
# Thailand AI Market Intelligence — environment configuration
# NEVER commit real credentials. Copy to .env and fill in.
# ============================================================

# --- observation engines (only what you use is required) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# --- API security (see SECURITY.md) ---
# comma-separated accepted keys. Unset = OPEN mode (writes allowed, logged).
AIBT_API_KEYS=
# "true" -> read endpoints also require a key
AIBT_REQUIRE_AUTH=
# comma-separated allowed CORS origins. Unset = "*" (logged warning).
AIBT_ALLOWED_ORIGINS=
AIBT_MAX_CONCURRENT_SCANS=2
AIBT_MAX_RUNS_PER_DAY=200

# --- runtime ---
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
ENTITIES_PATH=config/entities.yaml
